# Testnet only. Never set this to mainnet.
# Do not put private keys in this file; use the NEAR CLI legacy keychain
# (~/.near-credentials/testnet/), which is outside the repository.

NEAR_NETWORK=testnet
NEAR_CONTRACT=sgd3147470a.testnet
NEAR_OWNER=sgd3147470a.testnet
NEAR_AGENT=sga3147470a.testnet

# Optional OpenAI-compatible LLM for the purchasing agent.
# Without a key, the agent uses a deterministic offline fallback.
# NEAR AI Cloud: https://docs.near.ai/cloud/guides/openai-compatibility
# SPENDGUARD_LLM_BASE_URL=https://cloud-api.near.ai/v1
# SPENDGUARD_LLM_API_KEY=
# SPENDGUARD_LLM_MODEL=zai-org/GLM-5.1-FP8
# Aliases also accepted: OPENAI_BASE_URL, OPENAI_API_KEY, NEAR_AI_API_KEY.
